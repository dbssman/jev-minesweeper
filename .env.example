# TypeSafe (Jev) API key. Get one at https://console.typesafe.ai (early access).
# Copy this file to .env and paste your key, or export TYPESAFE_API_KEY instead.
# The key is read server-side only and is never sent to the browser.
TYPESAFE_API_KEY=

# Optional overrides.
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_TIMEOUT_MS=20000
# PORT=4322
# HOST=127.0.0.1
